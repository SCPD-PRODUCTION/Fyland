    <string name="s245" formatted="false">"02  /  NOTIFIKASI"</string>
    <string name="s246" formatted="false">"Block All · notifikasi bawaan"</string>
    <string name="s247" formatted="false">"Notifikasi bawaan aplikasi dihapus langsung begitu masuk, jadi yang tampil hanya island. Chat yang bisa dibalas ikut dihapus (balasan lewat island tetap jalan). Musik, panggilan, alarm dan notifikasi menetap dipertahankan."</string>
    <string name="s248" formatted="false">"Aktifkan Block All?"</string>
    <string name="s249" formatted="false">"Notifikasi biasa akan dihapus dari panel Android begitu masuk dan hanya tampil di island. Salinannya disimpan sementara di memori island (maks. 30). Notifikasi panggilan, alarm, musik dan yang menetap dipertahankan. Layar mati atau terkunci: notifikasi tidak dihapus."</string>
    <string name="s250" formatted="false">"Aktifkan"</string>
    <string name="s251" formatted="false">"Redam pop-up bawaan"</string>
    <string name="s252" formatted="false">"Saat Block All aktif, saluran notifikasi aplikasi diturunkan dari Tinggi ke Default supaya pop-up (heads-up) bawaan tidak muncul lagi. Suara tetap ada. Otomatis dikembalikan saat opsi ini atau Block All dimatikan."</string>
    <string name="s253" formatted="false">"Pertahankan notifikasi yang bisa dibalas"</string>
    <string name="s254" formatted="false">"Nyalakan jika balasan lewat island gagal pada aplikasi tertentu. Chat akan muncul dobel (island + bawaan)."</string>
    <string name="s255" formatted="false">"Otomatis buka detail"</string>
    <string name="s256" formatted="false">"Langsung bentangkan island saat notifikasi masuk."</string>
    <string name="s257" formatted="false">"Tampilkan isi pesan"</string>
    <string name="s258" formatted="false">"Jika dimatikan, island hanya menampilkan nama aplikasi."</string>
    <string name="s259" formatted="false">"Notifikasi senyap"</string>
    <string name="s260" formatted="false">"Sertakan notifikasi tanpa suara."</string>
    <string name="s261" formatted="false">"Selalu aktif di latar belakang"</string>
    <string name="s262" formatted="false">"Menampilkan notifikasi senyap kecil agar Android tidak mematikan island. Disarankan tetap menyala supaya island selalu tampil."</string>
    <string name="s263" formatted="false">"Sembunyikan saat landscape"</string>
    <string name="s264" formatted="false">"Jika mati, island tampil sebagai pil vertikal di sisi kamera saat landscape (seperti di game). Ketuk pil untuk membuka detail."</string>
    <string name="s265" formatted="false">"Isi pesan di lock screen"</string>
    <string name="s266" formatted="false">"Jika mati (disarankan), island di lock screen hanya menampilkan nama aplikasi, tanpa isi pesan dan tanpa tombol balas."</string>
