    <string name="s312" formatted="false">"Mikrofon dipakai"</string>
    <string name="s313" formatted="false">"Titik oranye dengan gelombang selama ada aplikasi yang merekam suara. Hanya indikator; island tidak mendengar apa pun."</string>
