    <string name="s293" formatted="false">"Animasi spring ala iPhone"</string>
    <string name="s294" formatted="false">"Island melar dan menyusut dengan gerak pegas (sedikit memantul), konten muncul dengan zoom dan blur. Matikan jika HP terasa berat."</string>
