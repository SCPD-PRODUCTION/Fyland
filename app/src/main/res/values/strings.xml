    <string name="s261" formatted="false">"Always active in the background"</string>
    <string name="s262" formatted="false">"Shows a small silent notification so Android does not kill the island. Recommended to keep on so the island is always visible."</string>
    <string name="s263" formatted="false">"Hide in landscape"</string>
    <string name="s264" formatted="false">"If off, the island appears as a vertical pill beside the camera in landscape (like in games). Tap the pill to open details."</string>
