    <string name="s245" formatted="false">"02  /  NOTIFICATIONS"</string>
    <string name="s246" formatted="false">"Block All · native notifications"</string>
    <string name="s247" formatted="false">"An app's own notification is removed as soon as it arrives, so only the island is shown. Repliable chats are removed too (replying through the island still works). Music, calls, alarms and ongoing notifications are kept."</string>
    <string name="s248" formatted="false">"Enable Block All?"</string>
    <string name="s249" formatted="false">"Regular notifications will be removed from the Android panel as soon as they arrive and shown only in the island. A copy is kept temporarily in the island's memory (max. 30). Call, alarm, music and ongoing notifications are kept. Screen off or locked: notifications are not removed."</string>
    <string name="s250" formatted="false">"Enable"</string>
    <string name="s251" formatted="false">"Mute native pop-ups"</string>
    <string name="s252" formatted="false">"While Block All is on, apps' notification channels are lowered from High to Default so the native heads-up pop-up no longer appears. Sound stays. Restored automatically when this option or Block All is turned off."</string>
    <string name="s253" formatted="false">"Keep repliable notifications"</string>
    <string name="s254" formatted="false">"Turn on if replying through the island fails in a certain app. Chats will appear twice (island + native)."</string>
    <string name="s255" formatted="false">"Auto-open details"</string>
    <string name="s256" formatted="false">"Expand the island right away when a notification arrives."</string>
